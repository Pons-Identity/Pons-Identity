{
  "name": "simple-idp",
  "version": "1.0.0",
  "description": "Simple SAML 2.0 Identity Provider",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "test": "node --test test/*.test.js",
    "test:web": "npm --prefix web test",
    "docs:lint": "redocly lint",
    "docs:build": "redocly build-docs docs/openapi.yaml --output docs/api.html --inlineBundle --title \"Pons Identity User API\"",
    "upgrade": "node scripts/upgrade.js"
  },
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "csv-parse": "^7.0.3",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "ldapts": "^9.2.0",
    "maxmind": "^5.0.7",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.0",
    "yaml": "^2.9.1"
  }
}
